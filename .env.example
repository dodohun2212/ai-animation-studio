# Copy this file to .env and fill in local values.
OPENAI_API_KEY=
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4_turbo
RUNWAY_RATIO=720:1280
RUNWAY_DURATION_SECONDS=5
RUNWAY_MONTHLY_BUDGET=10
MONTHLY_BUDGET=10
BUDGET_WARNING_THRESHOLD=0.8
LOG_LEVEL=INFO
OUTPUT_DIRECTORY=output
API_TIMEOUT_SECONDS=60
MAX_RETRIES=2
OPENAI_STORY_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_FORMAT=png
APP_MAX_IMAGE_CALLS_PER_JOB=6
APP_MAX_STORY_CALLS_PER_JOB=1
APP_MAX_PLAN_CALLS_PER_JOB=1
APP_MAX_SUMMARY_CALLS_PER_JOB=1
APP_MAX_REGEN_CALLS_PER_SCENE=3
APP_DAILY_API_CALL_LIMIT=50
APP_MAX_CONCURRENT_API_JOBS=1
APP_CONFIRM_BEFORE_PAID_RUN=true
APP_MAX_LONG_PROJECT_EPISODES=60
RUN_OPENAI_INTEGRATION_TESTS=false
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Optional local face consistency check (no model is bundled)
FACE_CHECK_ENABLED=false
FACE_PASS_THRESHOLD=0.60
FACE_WARNING_THRESHOLD=0.40
FACE_MODEL_NAME=buffalo_l
# FACE_MODEL_DIRECTORY=C:\path\to\insightface-model-root
