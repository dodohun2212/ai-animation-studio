# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node.js / TypeScript
node_modules/
dist/
dist-bundle/
release/
coverage/
*.tsbuildinfo

# Environment and secrets
.env

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime data
cache/*
logs/*
images/generated/*
images/temp/*
videos/rendered/*
videos/final/*
videos/temp/*
output/reels/*
output/shorts/*
output/thumbnails/*
output/archive/*

# Keep empty runtime directories
!.gitkeep

# Agent-to-agent mailbox (local coordination, never committed)
.claude-bridge/

# Local project data the app writes at runtime (projects, budget ledgers, asset library).
# Never committed: it is the user machine every install builds up, not source.
learning_data/

# Instagram connection: Meta app id/secret and the long-lived token, written at runtime
# under PROVIDER_SETTINGS_ROOT (apps/backend in dev). A real secret — never committed.
instagram_connection.json
